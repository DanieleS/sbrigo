# Copia in .env e adatta i valori. Tutte le variabili hanno prefisso SBRIGO_.

# Indirizzo di ascolto del container
SBRIGO_ADDR=:8080
# URL pubblico dietro il reverse proxy (usato per il redirect OIDC e per i cookie Secure)
SBRIGO_PUBLIC_URL=https://sbrigo.casa.example

# PostgreSQL dell'homelab
SBRIGO_DATABASE_URL=postgres://sbrigo:password@postgres.lan:5432/sbrigo?sslmode=disable

# Chiave HMAC dei cookie di sessione (almeno 32 caratteri: openssl rand -base64 48)
SBRIGO_SESSION_SECRET=cambiami-con-una-stringa-casuale-lunga-almeno-32-caratteri
# Durata della sessione (default 720h = 30 giorni)
SBRIGO_SESSION_TTL=720h
# Redis per le sessioni lato server (revoca, "esci da tutti i dispositivi").
# Vuoto = cookie firmati stateless, senza revoca.
SBRIGO_REDIS_URL=redis://redis.lan:6379/0

# Logto (OIDC, Authorization Code + PKCE). Il redirect URI da registrare è
# ${SBRIGO_PUBLIC_URL}/auth/callback
SBRIGO_OIDC_ISSUER=https://logto.casa.example/oidc
SBRIGO_OIDC_CLIENT_ID=xxxxxxxxxxxxxxxx
# Necessario solo per applicazioni "Traditional web" in Logto; vuoto per client pubblici
SBRIGO_OIDC_CLIENT_SECRET=

# API Key statica per l'agente (header X-API-Key). Vuota = accesso agente disabilitato
SBRIGO_API_KEY=

# Solo sviluppo locale: autentica ogni richiesta anonima come questo utente. MAI in produzione.
# SBRIGO_DEV_AUTO_LOGIN_EMAIL=dev@example.com

# debug | info | warn | error
SBRIGO_LOG_LEVEL=info
